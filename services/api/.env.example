# Nexora API configuration. Copy to .env, or run: python3 infrastructure/scripts/bootstrap-env.py
# Never commit real values. Values marked [secret] must come from a secret manager in production.

APP_ENV=development
API_PUBLIC_URL=http://localhost:8000
WEB_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=false

# ---- Database ------------------------------------------------------------------------------
# Local dev: SQLite (tables auto-created). Production: Supabase Postgres, schema from supabase/migrations.
DATABASE_URL=sqlite+aiosqlite:///./nexora.db
# Supabase session pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Transaction pooler (port 6543) needs: DATABASE_STATEMENT_CACHE_SIZE=0
DATABASE_AUTO_CREATE=true

# ---- Auth ----------------------------------------------------------------------------------
# Supabase: the API verifies access tokens with the project's JWKS (asymmetric signing keys).
SUPABASE_URL=
# Only needed for projects still on the legacy shared JWT secret: [secret]
SUPABASE_JWT_SECRET=
# Server-only, used for account deletion. Never expose to browsers: [secret]
SUPABASE_SERVICE_ROLE_KEY=
# Local development without Supabase. Refused when APP_ENV=production.
AUTH_DEV_MODE=true
DEV_JWT_SECRET=
# Shared with the voice agent only: [secret]
INTERNAL_SERVICE_KEY=

# ---- LLM -----------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDERS=openai_compatible,offline
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
# Optional OpenAI-compatible cloud fallback (any vendor with /v1/chat/completions + tools)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# Embeddings for memory search: ollama (nomic-embed-text, 768 dims) or hashing (lexical dev fallback)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# ---- Vault / key management ------------------------------------------------------------------
KEY_PROVIDER=local
# "<id>:<base64 32 bytes>" comma separated; keep retired keys until rotation finishes: [secret]
VAULT_MASTER_KEYS=
VAULT_ACTIVE_KEY_ID=
# KEY_PROVIDER=aws_kms
AWS_KMS_KEY_ID=
AWS_REGION=
VAULT_REAUTH_MAX_AGE_MINUTES=0

# ---- LiveKit (voice) -------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=nexora-voice
VOICE_TOKEN_TTL_SECONDS=600
VOICE_MAX_SESSION_SECONDS=900

# ---- Integrations (all optional) ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Public OSM endpoints are for light use only - self-host or use a commercial provider in production.
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Comma-separated mirrors, tried in order (keep it to two: each try may take up to 25 s and the web waits 60 s).
OVERPASS_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter
OSM_USER_AGENT=Nexora/0.1 (self-hosted personal assistant)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# NEWS_FEEDS=[{"name":"BBC","url":"https://feeds.bbci.co.uk/news/rss.xml","category":"world"}]

# ---- Automations ---------------------------------------------------------------------------
# true: run the scheduler inside the API (single instance). Production: run app.automations.worker.
RUN_SCHEDULER_IN_API=true
SCHEDULER_POLL_SECONDS=15
