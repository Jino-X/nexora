# Nexora voice agent. Copy to .env (bootstrap-env.py fills the internal key).

# LiveKit (Cloud: Project Settings -> Keys). Read by the LiveKit Agents CLI.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=nexora-voice

# Core API (same value as INTERNAL_SERVICE_KEY in services/api/.env)
NEXORA_API_URL=http://localhost:8000
NEXORA_INTERNAL_SERVICE_KEY=

# Speech providers: the Nexora speech server (IndicConformer + Indic Parler-TTS)
STT_PROVIDER=speech_server
TTS_PROVIDER=speech_server
SPEECH_SERVER_URL=http://localhost:8100
SPEECH_SERVER_KEY=
TTS_SAMPLE_RATE=24000
# Optional LiveKit Inference fallbacks (LiveKit Cloud, billed). Check language support first:
# STT_FALLBACK_MODELS=deepgram/nova-3
# TTS_FALLBACK_MODELS=cartesia/sonic-2
# TTS_FALLBACK_VOICE=

# Turn handling: multilingual (semantic turn detector + VAD) or vad
TURN_DETECTOR=multilingual
MIN_ENDPOINTING_DELAY=0.5
MAX_ENDPOINTING_DELAY=3.0

MAX_SESSION_SECONDS=900
IDLE_TIMEOUT_SECONDS=90
WAKE_WORD_NO_SPEECH_SECONDS=8
