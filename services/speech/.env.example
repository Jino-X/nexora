# Nexora speech server. Internal service only: never expose it publicly.
SPEECH_API_KEY=
SPEECH_DEVICE=auto
SPEECH_ENABLE_STT=true
SPEECH_ENABLE_TTS=true
SPEECH_WARMUP=true
SPEECH_INDIC_MODEL=ai4bharat/indic-conformer-600m-multilingual
SPEECH_INDIC_DECODING=ctc
# English STT + language identification (IndicConformer has no English). Empty to disable.
SPEECH_WHISPER_MODEL=small
SPEECH_DEFAULT_LANGUAGE=ta
SPEECH_TTS_MODEL=ai4bharat/indic-parler-tts
SPEECH_TTS_VOICE_TA=Jaya
SPEECH_TTS_VOICE_EN=Thoma
SPEECH_TTS_OUTPUT_SAMPLE_RATE=24000
