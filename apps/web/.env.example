# Nexora web app. Copy to .env.local. NEXT_PUBLIC_* values are visible in the browser, so never
# put secrets here.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (Project Settings -> API). Leave empty to use the API's dev login (development only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LiveKit server URL (used for the Content-Security-Policy; tokens always come from the API)
NEXT_PUBLIC_LIVEKIT_URL=
